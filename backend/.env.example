NODE_ENV=production
PORT=4000
# Use la URL pooled de Neon con sslmode=require y connection_limit=5.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connection_limit=5
JWT_SECRET=replace_with_a_cryptographically_random_value_of_at_least_32_chars
JWT_EXPIRES_IN=24h
CORS_ORIGINS=https://your-project.vercel.app
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM=Planilla de Pago <mailer@example.com>
SMTP_REJECT_UNAUTHORIZED=true
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
# Solo para ejecutar manualmente `npm run seed` en una base nueva.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_a_unique_password_of_at_least_12_chars
