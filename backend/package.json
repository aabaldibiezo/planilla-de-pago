{
  "name": "planilla-de-pago-backend",
  "version": "1.0.0",
  "description": "Backend API for Planilla de Pago - Payroll & Time Tracking System",
  "main": "src/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "prisma generate",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/lint.js",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:test-payroll": "node prisma/seed-test-payroll.js",
    "seed:plans": "node prisma/seed-plans.js",
    "reset:clientes": "node prisma/reset-clientes.js"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.9.0"
  }
