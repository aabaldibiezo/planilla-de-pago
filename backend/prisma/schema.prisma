// Prisma Schema — Sistema de Gestión de Nómina
// Planilla de Pago v2.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// SUPER_ADMIN administra la plataforma (empresas, planes y cobros) y no
/// pertenece a ninguna empresa; ADMIN y EMPLOYEE siempre pertenecen a una.
/// La restricción `user_company_scope` en la base impone esa correspondencia.
enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

/// Estado de la suscripción de una empresa cliente.
/// READ_ONLY no expulsa a nadie: se puede entrar y consultar el historial,
/// pero toda escritura queda bloqueada hasta que se registre el pago.
enum CompanyStatus {
  ACTIVE
  READ_ONLY
}

enum EmployeeType {
  FIJO
  TEMPORAL
}

enum ScheduleType {
  FULL_TIME
  FLEXIBLE
  SPECIFIC_DAYS
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum JustificationStatus {
  PENDING
  JUSTIFIED
  REJECTED
}

enum OvertimePaymentMode {
  SAME_RATE
  LOWER_RATE
  HIGHER_RATE
  MULTIPLIER
  FIXED_AMOUNT
  TIME_OFF
  UNPAID
}

enum DiscountType {
  UNJUSTIFIED_DELAY
  SALARY_ADVANCE
  COMPANY_DAMAGE
  LOAN
  UNJUSTIFIED_ABSENCE
  OTHER
}

enum PaymentDetailType {
  INCOME
  DISCOUNT
  INFORMATION
}

enum CompensationStatus {
  AVAILABLE
  PARTIALLY_USED
  USED
  CANCELLED
}

/// Resultado de comparar la ubicación capturada contra la sede asignada.
/// UNAVAILABLE se distingue de SUSPICIOUS a propósito: sin GPS (permiso
/// denegado, sin señal, dentro de un edificio) no es lo mismo que estar lejos.
enum LocationStatus {
  NOT_REQUIRED
  OK
  SUSPICIOUS
  UNAVAILABLE
}

/// Revisión administrativa de una marcación señalada como sospechosa.
enum ReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// ===================================================================
//  PLATAFORMA — suscripciones
//
//  ⚠️ Todo el dinero de esta sección está en DÓLARES (USD), a diferencia
//  del resto del sistema (sueldos, boletas), que está en bolivianos.
//  Son dos monedas para dos propósitos y no se convierten entre sí: no
//  existe tipo de cambio en el sistema y no debe existir. Por eso los
//  campos llevan el sufijo `Usd` en el nombre.
// ===================================================================

/// Plan comercial de la plataforma. Editable desde el panel de súper admin.
model Plan {
  id              Int      @id @default(autoincrement())
  /// Identificador estable. El nombre visible sí puede cambiarse desde el
  /// panel, así que el código no se deriva de él ni se muestra al cliente.
  code            String   @unique
  name            String
  /// null = ilimitado. Un número mágico (999999) obligaría a recordar la
  /// convención en cada comparación; null obliga a tratarlo explícitamente.
  maxEmployees    Int?
  monthlyPriceUsd Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companies Company[]
}

/// Empresa cliente. Es la raíz del ámbito de datos: todo lo operativo
/// (usuarios, sedes, asistencia, nómina) pertenece a exactamente una.
model Company {
  id           Int     @id @default(autoincrement())
  name         String
  taxId        String?
  contactEmail String
  contactPhone String?
  planId       Int
  plan         Plan    @relation(fields: [planId], references: [id])

  status          CompanyStatus @default(ACTIVE)
  nextDueDate     DateTime      @db.Date
  /// Vencimiento para el que ya se envió el aviso previo. Permite avisar una
  /// sola vez sin necesidad de un planificador de tareas.
  reminderSentFor DateTime?     @db.Date

  /// Cuántos jornales (sueldo ÷ 30) se pagan por cada domingo de descanso o
  /// feriado trabajado. 2 = pago doble.
  extraDayFactor Decimal @default(2) @db.Decimal(4, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  users                User[]
  worksites            Worksite[]
  clients              Client[]
  expenseCategories    ExpenseCategory[]
  statementEntries     StatementEntry[]
  holidays             Holiday[]
  auditLogs            AuditLog[]
  subscriptionPayments SubscriptionPayment[]

  @@index([status, nextDueDate])
}

/// Pago de suscripción registrado por el súper administrador.
model SubscriptionPayment {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  amountUsd   Decimal  @db.Decimal(10, 2)
  paidAt      DateTime @default(now())
  /// Mes de suscripción que cubre este pago (1-12 y año).
  periodMonth Int
  periodYear  Int

  /// Instantánea del plan al momento del cobro: si mañana cambia el precio o
  /// el nombre del plan, el historial debe seguir mostrando lo que se cobró.
  planNameSnapshot     String
  planPriceUsdSnapshot Decimal @db.Decimal(10, 2)

  recordedBy Int
  notes      String?
  createdAt  DateTime @default(now())

  // Un mismo mes no puede cobrarse dos veces a la misma empresa.
  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, paidAt])
}

model User {
  id                  Int                  @id @default(autoincrement())
  /// null únicamente para SUPER_ADMIN, que administra la plataforma y no
  /// pertenece a ninguna empresa. La restricción `user_company_scope` de la
  /// base impide cualquier otra combinación.
  companyId           Int?
  company             Company?             @relation(fields: [companyId], references: [id])
  /// null solo para el TEMPORAL sin acceso: lo marca el encargado y no entra
  /// a la aplicación. Postgres admite varios null en un índice único.
  email               String?              @unique
  password            String // Hash bcrypt; lo usan tanto ADMIN como EMPLOYEE
  firstName           String
  lastName            String
  /// Celular normalizado (8 dígitos). Sirve para entrar a la app igual que el
  /// correo, así que es único; el fijo debe tener correo o celular.
  phone               String?              @unique
  role                Role                 @default(EMPLOYEE)
  employeeType        EmployeeType         @default(FIJO)
  /// Clasificación contable, para separar las dos líneas de salario del
  /// estado de resultados. No se deriva de `role` ni de `employeeType`.
  staffCategory       StaffCategory        @default(OPERATIVO)
  monthlySalary       Decimal              @default(0) // Salario mensual en Bs.
  monthlyHours        Decimal              @default(160) // Horas laborales del mes
  hourlyRate          Decimal              @default(0) // Calculado: ver lib/pay-scheme.js
  /// Pago por día trabajado. Solo lo usa el TEMPORAL, que cobra por día; el
  /// FIJO cobra `monthlySalary` sin importar cuántos días marcó.
  dailyWage           Decimal              @default(0) @db.Decimal(10, 2)
  scheduledEntryTime  String               @default("08:00") // Hora de ingreso programada HH:MM
  isActive            Boolean              @default(true)
  // --- Credenciales del empleado ---
  mustChangePassword  Boolean              @default(false) // Fuerza el cambio tras la contraseña temporal
  passwordSetAt       DateTime? // Última vez que el usuario definió su propia contraseña
  lastLoginAt         DateTime?
  credentialsSentAt   DateTime? // Último envío correcto del correo con credenciales
  credentialsError    String? // Motivo del último fallo de envío, para que el admin reaccione
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attendances         Attendance[]
  payments            Payment[]
  scheduleType        ScheduleType         @default(FULL_TIME)
  scheduleBlocks      ScheduleBlock[]
  attendanceSessions  AttendanceSession[]
  overtimeRecords     Overtime[]           @relation("OvertimeEmployee")
  compensations       TimeCompensation[]
  discounts           Discount[]           @relation("DiscountEmployee")
  auditLogs           AuditLog[]           @relation("AuditActor")
  worksiteAssignments WorksiteAssignment[]

  // `email` sigue siendo único a nivel global y no por empresa: el login se
  // hace solo con el correo, así que repetirlo entre empresas volvería
  // ambigua la autenticación.
  // Índice pensado para el conteo de empleados activos contra el límite del plan.
  @@index([companyId, role, isActive])
}

// ===================================================================
//  CLIENTES Y CONTRATOS
//
//  A quién le presta servicio la empresa de limpieza y por cuánto.
//
//  ⚠️ Los montos de esta sección están en BOLIVIANOS, como los sueldos y
//  las boletas. No confundir con `Plan.monthlyPriceUsd` ni
//  `SubscriptionPayment.amountUsd`, que son la suscripción a la plataforma
//  y están en dólares. Por eso esos llevan sufijo `Usd` y estos no.
// ===================================================================

/// Modalidad de cobro. Se define por contrato y no por cliente: un mismo
/// cliente puede pagar un servicio por adelantado y otro a mes vencido.
enum PaymentTerms {
  ANTICIPADO
  POSTERIOR
}

/// Clasificación contable del personal, para separar las dos líneas de salario
/// del estado de resultados.
///
/// No se deriva de `role` ni de `employeeType`: el primero es un permiso del
/// sistema y el segundo es el tipo de contrato. Una asistente administrativa
/// es EMPLOYEE y FIJO igual que quien limpia, y su sueldo va en otra línea.
enum StaffCategory {
  OPERATIVO
  ADMINISTRATIVO
}

/// Un costo operativo resta del resultado del negocio; un gasto financiero
/// (intereses, comisiones) se muestra aparte, como en el formato contable.
enum ExpenseKind {
  OPERATING
  FINANCIAL
}

/// Tipo de línea cargada a mano en el estado de resultados.
enum EntryType {
  OTHER_INCOME
  EXPENSE
}

/// Cliente de la empresa de limpieza: el edificio, el consorcio, la oficina.
model Client {
  id           Int      @id @default(autoincrement())
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  taxId        String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    Int?
  updatedBy    Int?

  contracts Contract[]

  @@index([companyId, isActive])
}

/// Acuerdo con un cliente. Un cliente puede tener varios contratos
/// independientes, cada uno con su propio monto, modalidad y sedes.
model Contract {
  id           Int          @id @default(autoincrement())
  clientId     Int
  client       Client       @relation(fields: [clientId], references: [id])
  name         String
  /// Número o referencia del contrato en papel, si lo hay.
  reference    String?
  paymentTerms PaymentTerms
  startDate    DateTime?    @db.Date
  endDate      DateTime?    @db.Date
  /// Día del mes en que el cliente paga (1-31). Con ANTICIPADO vence ese día
  /// del mismo mes; con POSTERIOR, ese día del mes siguiente.
  billingDay   Int          @default(5)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    Int?
  updatedBy    Int?

  rates       ContractRate[]
  worksites   Worksite[]
  collections ContractCollection[]

  @@index([clientId, isActive])
}

/// Historial de montos de un contrato.
///
/// Nunca se edita ni se borra un monto: se agrega uno nuevo con su fecha de
/// vigencia. Así un ajuste de precio no reescribe lo que se cobró antes, que
/// es justamente lo que haría falta reconstruir en una discusión con el
/// cliente meses después.
model ContractRate {
  id         Int      @id @default(autoincrement())
  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])
  /// Monto mensual en bolivianos.
  amount     Decimal  @db.Decimal(12, 2)
  validFrom  DateTime @db.Date
  /// Por qué cambió: "ajuste por inflación", "se sumó el subsuelo".
  notes      String?
  createdAt  DateTime @default(now())
  createdBy  Int?

  // Dos montos con la misma fecha de vigencia dejarían indefinido cuál rige.
  @@unique([contractId, validFrom])
  @@index([contractId, validFrom])
}

/// Cobro registrado de un mes de un contrato.
///
/// El monto se guarda copiado del vigente al momento de cobrar: si después
/// cambia la tarifa, lo cobrado sigue siendo lo que fue.
model ContractCollection {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id])
  month       Int
  year        Int
  amount      Decimal  @db.Decimal(12, 2)
  collectedOn DateTime @db.Date
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   Int?

  // Un mismo mes no se cobra dos veces.
  @@unique([contractId, year, month])
}

// ===================================================================
//  ESTADO DE RESULTADOS
//
//  Ingresos, gastos y saldo mensual de la empresa cliente.
//
//  ⚠️ Los montos están en BOLIVIANOS, como la nómina y los contratos.
//  No confundir con la suscripción a la plataforma, que va en dólares.
//
//  Acá SOLO vive lo que se carga a mano. Los ingresos por servicios se
//  derivan de los contratos y los salarios de la nómina: guardarlos
//  sería quedarse con una foto vieja apenas se confirme un pago.
// ===================================================================

/// Categoría de gasto.
///
/// Las predefinidas se siembran POR EMPRESA y no como catálogo global, así una
/// empresa puede renombrar "insumos" o desactivar "combustible" sin afectar a
/// las demás.
model ExpenseCategory {
  id        Int         @id @default(autoincrement())
  companyId Int
  company   Company     @relation(fields: [companyId], references: [id])
  name      String
  kind      ExpenseKind @default(OPERATING)
  /// Marca las sembradas por el sistema. No impide borrarlas: permite ofrecer
  /// "restaurar las predefinidas" si alguien se pasa de largo.
  isSystem  Boolean     @default(false)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(100)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  createdBy Int?
  updatedBy Int?

  entries StatementEntry[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

/// Línea cargada a mano: un gasto, o un ingreso fuera de contrato.
///
/// Al ser por mes, borrar la de un mes nunca puede afectar a otro: es lo que
/// permite quitar de un clic una categoría que este mes no aplica sin tocar
/// los meses donde sí se usó.
model StatementEntry {
  id          Int              @id @default(autoincrement())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id])
  month       Int
  year        Int
  type        EntryType
  /// Obligatorio si `type = EXPENSE`; null en otros ingresos.
  categoryId  Int?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description String
  amount      Decimal          @db.Decimal(12, 2)
  /// Fecha real del gasto dentro del mes, si se conoce. No afecta el cálculo:
  /// el estado es mensual y toma el mes y año de arriba.
  occurredOn  DateTime?        @db.Date
  createdAt   DateTime         @default(now())
  createdBy   Int?

  @@index([companyId, year, month])
  @@index([categoryId])
}

/// Feriado propio de una empresa: departamental o decretado.
///
/// Los nacionales NO se guardan: se calculan en lib/holidays.js, así no hay
/// que actualizar una tabla cada año y los que dependen de la Pascua caen
/// solos en su fecha.
model Holiday {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())
  createdBy Int?

  @@unique([companyId, date])
}

/// Lugar físico donde el empleado presta servicio.
/// `contractId` queda reservado para la Fase 4: cuando existan contratos de
/// clientes, la sede colgará de ellos sin necesidad de una migración destructiva.
model Worksite {
  id           Int       @id @default(autoincrement())
  /// Única entidad operativa sin `userId`, así que necesita el vínculo
  /// directo con la empresa para poder acotarse.
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id])
  name         String
  address      String
  latitude     Decimal
  longitude    Decimal
  /// Radio tolerado en metros. Configurable por sede: una oficina no necesita
  /// el mismo margen que un predio grande o un condominio.
  radiusMeters Int       @default(150)
  /// Contrato que cubre esta sede. Nullable: una sede puede existir antes de
  /// que se cargue el contrato, o no tener uno (una oficina propia).
  contractId   Int?
  contract     Contract? @relation(fields: [contractId], references: [id])
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    Int?
  updatedBy    Int?

  assignments        WorksiteAssignment[]
  attendanceSessions AttendanceSession[]

  @@index([companyId, isActive])
  @@index([contractId])
}

/// Asignación de un empleado a una sede. Soporta rotación: por día de la
/// semana (recurrente) o por fecha puntual, con vigencia acotada.
model WorksiteAssignment {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  worksiteId   Int
  worksite     Worksite  @relation(fields: [worksiteId], references: [id])
  /// 0-6 para una asignación recurrente; null si es por fecha puntual.
  dayOfWeek    Int?
  /// Fecha concreta; null si la asignación es recurrente.
  specificDate DateTime? @db.Date
  startTime    String?
  endTime      String?
  validFrom    DateTime  @db.Date
  validUntil   DateTime? @db.Date
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    Int?
  updatedBy    Int?

  @@index([userId, dayOfWeek, isActive])
  @@index([userId, specificDate])
}

model ScheduleBlock {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  user               User                @relation(fields: [userId], references: [id])
  dayOfWeek          Int
  startTime          String
  endTime            String
  blockOrder         Int                 @default(1)
  crossesMidnight    Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          Int?
  updatedBy          Int?
  attendanceSessions AttendanceSession[]

  @@unique([userId, dayOfWeek, startTime, endTime])
  @@index([userId, dayOfWeek, isActive])
}

model Attendance {
  id             Int                 @id @default(autoincrement())
  userId         Int
  user           User                @relation(fields: [userId], references: [id])
  date           DateTime            @db.Date
  scheduledEntry String // HH:MM — Hora programada de ingreso
  actualEntry    String // HH:MM — Hora real de ingreso
  actualExit     String? // HH:MM — Hora real de salida (opcional hasta que marque salida)
  hoursWorked    Decimal             @default(0) // Horas efectivamente trabajadas en el día
  delayMinutes   Int                 @default(0) // Minutos de retraso (calculado)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessions       AttendanceSession[]
  createdBy      Int?
  updatedBy      Int?

  @@unique([userId, date]) // Un registro por empleado por día
}

model AttendanceSession {
  id                       Int                 @id @default(autoincrement())
  userId                   Int
  user                     User                @relation(fields: [userId], references: [id])
  attendanceId             Int?
  attendance               Attendance?         @relation(fields: [attendanceId], references: [id])
  scheduleBlockId          Int?
  scheduleBlock            ScheduleBlock?      @relation(fields: [scheduleBlockId], references: [id])
  workDate                 DateTime            @db.Date
  clockIn                  DateTime
  clockOut                 DateTime?
  workedMinutes            Int                 @default(0)
  delayMinutes             Int                 @default(0)
  earlyDepartureMinutes    Int                 @default(0)
  justificationStatus      JustificationStatus @default(PENDING)
  justificationReason      String?
  justificationNotes       String?
  justificationRequestedAt DateTime?
  justificationCreatedBy   Int?
  justificationReviewedBy  Int?
  justificationReviewedAt  DateTime?
  decisionReason           String?
  createdBy                Int?
  updatedBy                Int?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  // --- Marcación desde la app móvil ---
  /// Foto tomada en el momento. Nunca proviene de la galería: la app captura
  /// el fotograma con getUserMedia/expo-camera, sin usar selector de archivos.
  photoUrl          String?
  photoPublicId     String?
  capturedLatitude  Decimal?
  capturedLongitude Decimal?
  /// Precisión declarada por el GPS. Una precisión pésima explica una
  /// distancia grande sin que haya intención de engañar.
  gpsAccuracyMeters Int?
  /// Distancia a la sede más cercana entre las asignadas ese día.
  distanceMeters    Int?
  locationStatus    LocationStatus @default(NOT_REQUIRED)
  matchedWorksiteId Int?
  matchedWorksite   Worksite?      @relation(fields: [matchedWorksiteId], references: [id])
  deviceInfo        String?

  // --- Evidencia de la salida ---
  // Con geocerco estricto la salida también se valida, así que necesita su
  // propia foto y ubicación: las de la entrada no sirven para probar dónde
  // estaba la persona horas después.
  clockOutPhotoUrl       String?
  clockOutPhotoPublicId  String?
  clockOutLatitude       Decimal?
  clockOutLongitude      Decimal?
  clockOutAccuracyMeters Int?
  clockOutDistanceMeters Int?
  clockOutLocationStatus LocationStatus @default(NOT_REQUIRED)

  // --- Registro manual ---
  // Salida de emergencia cuando el GPS no funciona y el bloqueo dejaría a la
  // persona sin poder fichar. Solo un administrador puede usarla.
  registeredManually Boolean @default(false)
  manualReason       String?

  // --- Revisión administrativa ---
  reviewStatus ReviewStatus @default(NOT_REQUIRED)
  reviewedBy   Int?
  reviewedAt   DateTime?
  reviewNotes  String?

  @@index([userId, workDate])
  @@index([locationStatus, reviewStatus])
}

model Overtime {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  user               User                @relation("OvertimeEmployee", fields: [userId], references: [id])
  workDate           DateTime            @db.Date
  startTime          String
  endTime            String
  hours              Decimal
  reason             String
  status             WorkflowStatus      @default(PENDING)
  paymentMode        OvertimePaymentMode
  hourlyRateSnapshot Decimal             @default(0)
  multiplier         Decimal             @default(1)
  fixedAmount        Decimal?
  calculatedAmount   Decimal             @default(0)
  notes              String?
  requestedBy        Int
  approvedBy         Int?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  compensations      TimeCompensation[]
  paymentDetails     PaymentDetail[]

  @@index([userId, workDate, status])
}

model TimeCompensation {
  id             Int                @id @default(autoincrement())
  userId         Int
  user           User               @relation(fields: [userId], references: [id])
  overtimeId     Int?               @unique
  overtime       Overtime?          @relation(fields: [overtimeId], references: [id])
  generatedHours Decimal
  usedHours      Decimal            @default(0)
  remainingHours Decimal
  generatedAt    DateTime
  usedAt         DateTime?
  reason         String
  authorizedBy   Int
  notes          String?
  status         CompensationStatus @default(AVAILABLE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  paymentDetails PaymentDetail[]

  @@index([userId, status])
}

model Discount {
  id                Int             @id @default(autoincrement())
  userId            Int
  user              User            @relation("DiscountEmployee", fields: [userId], references: [id])
  type              DiscountType
  amount            Decimal
  discountDate      DateTime        @db.Date
  description       String
  status            WorkflowStatus  @default(PENDING)
  createdBy         Int
  approvedBy        Int?
  approvedAt        DateTime?
  notes             String?
  documentReference String?
  paymentId         Int?
  payment           Payment?        @relation(fields: [paymentId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paymentDetails    PaymentDetail[]

  @@index([userId, discountDate, status])
}

model Payment {
  id                    Int       @id @default(autoincrement())
  userId                Int
  user                  User      @relation(fields: [userId], references: [id])
  month                 Int // 1-12
  year                  Int
  monthlySalary         Decimal // Salario mensual al momento del pago
  hourlyRate            Decimal // Tarifa/hora al momento del pago
  totalHours            Decimal   @default(0) // Total horas efectivamente trabajadas en el mes
  totalDelayMinutes     Int       @default(0) // Total minutos de retraso en el mes
  delayHours            Decimal   @default(0) // totalDelayMinutes / 60
  discountAmount        Decimal   @default(0) // delayHours × hourlyRate
  grossPay              Decimal   @default(0) // totalHours × hourlyRate
  netPay                Decimal // grossPay - discountAmount
  paidAt                DateTime  @default(now())
  pdfPath               String? // Ruta al archivo PDF del comprobante
  emailSent             Boolean   @default(false)
  createdAt             DateTime  @default(now())
  totalIncome           Decimal   @default(0)
  totalDiscounts        Decimal   @default(0)
  overtimeAmount        Decimal   @default(0)
  justifiedDelayMinutes Int       @default(0)
  createdBy             Int?
  updatedBy             Int?
  pdfGeneratedAt        DateTime?
  emailError            String?
  emailRetryRequired    Boolean   @default(false)

  // --- Recibo físico firmado ---
  // Respaldo visual del papel que el empleado firmó al cobrar. El monto NO se
  // lee de la foto: sigue saliendo del cálculo de nómina. Esto solo adjunta la
  // evidencia de que el pago se entregó y se firmó.
  /// Foto del recibo. En producción es una URL de Cloudinary; en local, la
  /// ruta del archivo en backend/uploads/recibos (ignorado por git).
  receiptPhotoUrl      String?
  receiptPhotoPublicId String?
  /// Fecha en que se adjuntó, en hora de Bolivia. Se usa `boliviaToday()` y no
  /// la fecha del servidor: cerca de medianoche difieren en un día.
  receiptUploadedOn    DateTime? @db.Date
  receiptUploadedBy    Int?

  details   PaymentDetail[]
  discounts Discount[]

  @@unique([userId, month, year]) // Bloquea pagos duplicados del mismo mes
}

model PaymentDetail {
  id             Int               @id @default(autoincrement())
  paymentId      Int
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type           PaymentDetailType
  code           String
  description    String
  quantity       Decimal?
  rate           Decimal?
  amount         Decimal
  overtimeId     Int?
  overtime       Overtime?         @relation(fields: [overtimeId], references: [id])
  discountId     Int?
  discount       Discount?         @relation(fields: [discountId], references: [id])
  compensationId Int?
  compensation   TimeCompensation? @relation(fields: [compensationId], references: [id])
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([paymentId, type])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  /// Se escribe en un solo lugar (`audit.service.record`), así que guardarlo
  /// directamente sale barato y evita acotar la auditoría por un join con
  /// `actor`, que es nullable. null solo en acciones de plataforma.
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id])
  actorId      Int?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  action       String
  entity       String
  entityId     String
  employeeId   Int?
  reason       String?
  previousData Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorId, entity, action])
  @@index([employeeId])
}
